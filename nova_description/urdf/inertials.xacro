<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="box_inertia" params="mass x y z xyz:='0 0 0' rpy:='0 0 0'">

    <inertial>

      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />

      <inertia ixx="${mass/12*(y*y + z*z)}" ixy="0" ixz="0"
               iyy="${mass/12*(x*x + z*z)}" iyz="0"
               izz="${mass/12*(x*x + y*y)}"/>

    </inertial>

  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h xyz:='0 0 0' rpy:='0 0 0'">

    <inertial>

      <origin xyz="${xyz}" rpy="${rpy}" />

      <mass value="${mass}" />

      <inertia ixx="${mass/12*(3*r**2 + h**2)}" ixy="0" ixz="0"
               iyy="${mass/12*(3*r**2 + h**2)}" iyz="0"
               izz="${(mass*r**2)/2}"  />

    </inertial>

  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass r xyz:='0 0 0' rpy:='0 0 0'">

    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />

      <mass value="${mass}" />

      <inertia ixx="${2/5*mass*r**2}" ixy="0" ixz="0"
               iyy="${2/5*mass*r**2}" iyz="0"
               izz="${2/5*mass*r**2}"  />

    </inertial>

  </xacro:macro>
</robot>
