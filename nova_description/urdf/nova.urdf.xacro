<?xml version="1.0" ?>

<robot name="nova" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Chassis: The chassis is a box, the geometry of the base_link -->
  <xacro:property name="chassis_length" value="0.50" /> <!-- x axis, front to back -->
  <xacro:property name="chassis_width" value="0.40" />  <!-- y axis, side to side -->
  <xacro:property name="chassis_height" value="0.15" /> <!-- z axis, top to -->
  <xacro:property name="chassis_mass"  value="12" />
  <xacro:property name="chassis_z_offset" value="0.05" />

  <!-- Drive wheels -->
  <xacro:property name="wheel_radius" value="0.08" />
  <xacro:property name="wheel_width" value="0.04" />
  <xacro:property name="wheel_mass" value="1.0" />
  <xacro:property name="wheel_separation" value="0.46" />

  <!-- Casters -->
  <xacro:property name="caster_radius" value="0.04" />
  <xacro:property name="caster_mass" value="0.3" />
  <xacro:property name="caster_x" value="0.20" />

  <xacro:include filename="$(find nova_description)/urdf/inertials.xacro" />
  <xacro:include filename="$(find nova_description)/urdf/base.xacro" />
  <xacro:include filename="$(find nova_description)/urdf/wheel.xacro" />
  <xacro:wheel reflect="1" side="left" />
  <xacro:wheel reflect="-1" side="right" />


</robot>
